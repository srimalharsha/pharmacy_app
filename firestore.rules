rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isActiveSuperAdmin(){
   return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
    && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.active == true
    && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == "superAdmin";
  }
  function profile(){return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;}
  function isPharmacyMember(pharmacyId){
   return signedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
    && profile().active == true && profile().pharmacyId == pharmacyId;
  }
  function isPharmacyOwner(pharmacyId){return isPharmacyMember(pharmacyId) && profile().role == "owner";}
  function validStaffRole(role){return role == "staff";}
  function canManageInventory(pharmacyId, branchId, action){
   return isPharmacyOwner(pharmacyId) || (
    isPharmacyMember(pharmacyId) && profile().role == "staff"
    && profile().branchId == branchId
    && profile().permissions is map
    && profile().permissions.inventory is map
    && profile().permissions.inventory[action] == true
   );
  }
  function canManageBilling(pharmacyId, branchId, action){
   return isPharmacyOwner(pharmacyId) || (
    isPharmacyMember(pharmacyId) && profile().role == "staff"
    && profile().branchId == branchId
    && profile().permissions is map
    && profile().permissions.billing is map
    && profile().permissions.billing[action] == true
   );
  }
  function canManageModule(pharmacyId,branchId,module,action){
   return isPharmacyOwner(pharmacyId) || (
    isPharmacyMember(pharmacyId) && profile().role == "staff"
    && profile().branchId == branchId
    && profile().permissions is map
    && profile().permissions[module] is map
    && profile().permissions[module][action] == true
   );
  }
  function validParty(data){
   return data.keys().hasAll(["name","createdAt","createdBy","updatedAt","updatedBy"])
    && data.keys().hasOnly(["name","contact","phone","email","address","notes","createdAt","createdBy","updatedAt","updatedBy"])
    && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
    && data.createdAt is timestamp && data.updatedAt is timestamp
    && data.createdBy is string && data.updatedBy is string;
  }
  function transferApproved(pharmacyId,transferId){
   return existsAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(transferId))
    && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(transferId)).data.status == "approved"
    && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(transferId)).data.approvedBy == request.auth.uid
    && (isPharmacyOwner(pharmacyId) || (
     isPharmacyMember(pharmacyId) && profile().role == "staff"
     && profile().permissions is map && profile().permissions.stockTransfers is map
     && profile().permissions.stockTransfers.approve == true
     && (profile().branchId == getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(transferId)).data.fromBranchId
      || profile().branchId == getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(transferId)).data.toBranchId)
    ));
  }
  function validInventory(data){
   return data.keys().hasAll(["medicineName","genericName","strength","dosageForm","barcode","batchNumber","purchasePrice","sellingPrice","quantity","reorderLevel","expiryDate","createdAt","createdBy","updatedAt","updatedBy"])
    && data.keys().hasOnly(["medicineName","genericName","strength","dosageForm","barcode","batchNumber","purchasePrice","sellingPrice","quantity","reorderLevel","expiryDate","createdAt","createdBy","updatedAt","updatedBy","lastSaleId","lastVoidedSaleId","lastTransferId"])
    && data.medicineName is string && data.medicineName.size() >= 1 && data.medicineName.size() <= 120
    && data.genericName is string && data.genericName.size() <= 120
    && data.strength is string && data.strength.size() <= 60
    && data.dosageForm is string && data.dosageForm.size() <= 40
    && data.barcode is string && data.barcode.size() <= 80
    && data.batchNumber is string && data.batchNumber.size() >= 1 && data.batchNumber.size() <= 80
    && data.purchasePrice is number && data.purchasePrice >= 0
    && data.sellingPrice is number && data.sellingPrice >= 0
    && data.quantity is number && data.quantity >= 0
    && data.reorderLevel is number && data.reorderLevel >= 0
    && data.expiryDate is string && data.expiryDate.size() == 10
    && data.createdBy is string && data.updatedBy is string
    && data.createdAt is timestamp && data.updatedAt is timestamp;
  }
  match /platformAdmins/{uid}{
   allow get: if signedIn() && request.auth.uid == uid;
   allow list,create,update,delete: if false;
  }
  match /pharmacyApplications/{uid}{
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.status == "pending" && request.resource.data.pharmacyName is string
    && request.resource.data.pharmacyName.size() >= 2 && request.resource.data.pharmacyName.size() <= 120
    && request.resource.data.ownerName is string && request.resource.data.ownerName.size() >= 2
    && request.resource.data.ownerName.size() <= 100 && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 20
    && request.resource.data.address is string && request.resource.data.address.size() >= 5
    && request.resource.data.address.size() <= 300 && request.resource.data.email == request.auth.token.email
    && request.resource.data.planId in ["monthly","yearly"] && request.resource.data.createdAt == request.time
    && request.resource.data.keys().hasOnly(["ownerUid","pharmacyName","ownerName","phone","address","email","planId","status","createdAt"]);
   allow get: if (signedIn() && request.auth.uid == uid) || isActiveSuperAdmin();
   allow list: if isActiveSuperAdmin();
   allow update,delete: if isActiveSuperAdmin();
  }
  match /userProfiles/{uid}{
   allow get: if (signedIn() && request.auth.uid == uid) || (resource.data.pharmacyId is string && isPharmacyOwner(resource.data.pharmacyId));
   allow list: if resource.data.pharmacyId is string && isPharmacyOwner(resource.data.pharmacyId);
   allow create: if isActiveSuperAdmin() || (
    signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(["displayName","email","phone","role","pharmacyId","branchId","active","permissions","invitationId","createdAt"])
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.createdAt == request.time
    && request.resource.data.permissions is map
    && validStaffRole(request.resource.data.role) && request.resource.data.active == true
    && exists(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)/branches/$(request.resource.data.branchId))
    && exists(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId))
    && get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.status == "pending"
    && get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email
    && get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.pharmacyId == request.resource.data.pharmacyId
    && get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.branchId == request.resource.data.branchId
    && get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role
   );
   allow update: if isActiveSuperAdmin() || (
    resource.data.role != "owner" && resource.data.pharmacyId is string
    && isPharmacyOwner(resource.data.pharmacyId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active","role","branchId","permissions"])
    && validStaffRole(request.resource.data.role)
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["permissions"]) || request.resource.data.permissions is map)
    && request.resource.data.active is bool
    && exists(/databases/$(database)/documents/pharmacies/$(resource.data.pharmacyId)/branches/$(request.resource.data.branchId))
   );
   allow delete: if isActiveSuperAdmin();
  }
  match /staffInvitations/{inviteId}{
   allow create: if signedIn() && request.resource.data.status == "pending"
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.pharmacyId is string && isPharmacyOwner(request.resource.data.pharmacyId)
    && request.resource.data.email is string && request.resource.data.name is string
    && request.resource.data.role == "staff"
    && exists(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)/branches/$(request.resource.data.branchId))
    && request.resource.data.keys().hasOnly(["email","name","phone","role","branchId","pharmacyId","status","createdBy","createdAt"]);
   allow get: if isActiveSuperAdmin() || (signedIn() && resource.data.email == request.auth.token.email);
   allow list: if signedIn() && isPharmacyOwner(resource.data.pharmacyId);
   allow update: if isActiveSuperAdmin() || (signedIn()
    && resource.data.email == request.auth.token.email && resource.data.status == "pending"
    && request.resource.data.status == "accepted" && request.resource.data.acceptedUid == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","acceptedUid","acceptedAt"]));
   allow delete: if isPharmacyOwner(resource.data.pharmacyId) || isActiveSuperAdmin();
  }
  match /pharmacies/{pharmacyId}{
   allow get: if isActiveSuperAdmin() || isPharmacyMember(pharmacyId);
   allow list: if isActiveSuperAdmin();
   allow create,update,delete: if isActiveSuperAdmin();
   match /branches/{branchId}{
    allow get,list: if isActiveSuperAdmin() || isPharmacyMember(pharmacyId);
    allow create,update,delete: if isActiveSuperAdmin();
    match /sales/{saleId}{
     allow get,list: if canManageBilling(pharmacyId,branchId,"view") || canManageBilling(pharmacyId,branchId,"void") || canManageModule(pharmacyId,branchId,"reports","view");
     allow create: if canManageBilling(pharmacyId,branchId,"create")
      && request.resource.data.pharmacyId == pharmacyId
      && request.resource.data.branchId == branchId
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.status == "completed"
      && request.resource.data.billNumber is string
      && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
      && request.resource.data.discount is number && request.resource.data.discount >= 0
      && (request.resource.data.discount == 0 || canManageBilling(pharmacyId,branchId,"discount"))
      && request.resource.data.total is number && request.resource.data.total == request.resource.data.subtotal - request.resource.data.discount
      && request.resource.data.items is list && request.resource.data.items.size() > 0
      && request.resource.data.createdAt == request.time
      && request.resource.data.keys().hasOnly(["billNumber","customerName","customerPhone","items","subtotal","discount","total","paymentMethod","status","createdBy","createdAt","pharmacyId","branchId"]);
     allow update: if canManageBilling(pharmacyId,branchId,"void")
      && resource.data.status == "completed"
      && request.resource.data.status == "voided"
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","voidedAt","voidedBy"])
      && request.resource.data.voidedBy == request.auth.uid
      && request.resource.data.voidedAt == request.time;
     allow delete: if false;
     match /items/{itemId}{
      allow get,list: if canManageBilling(pharmacyId,branchId,"view") || canManageBilling(pharmacyId,branchId,"void");
      allow create: if canManageBilling(pharmacyId,branchId,"create")
       && existsAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(saleId))
       && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(saleId)).data.status == "completed"
       && request.resource.data.inventoryId == itemId
       && request.resource.data.quantity is number && request.resource.data.quantity > 0
       && request.resource.data.keys().hasOnly(["inventoryId","quantity"]);
      allow update,delete: if false;
     }
    }
    match /suppliers/{supplierId}{
     allow get,list: if canManageModule(pharmacyId,branchId,"suppliers","view");
     allow create: if canManageModule(pharmacyId,branchId,"suppliers","add")
      && validParty(request.resource.data) && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
     allow update: if canManageModule(pharmacyId,branchId,"suppliers","edit")
      && validParty(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt == request.time;
     allow delete: if canManageModule(pharmacyId,branchId,"suppliers","delete");
    }
    match /customers/{customerId}{
     allow get,list: if canManageModule(pharmacyId,branchId,"customers","view");
     allow create: if canManageModule(pharmacyId,branchId,"customers","add")
      && validParty(request.resource.data) && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
     allow update: if canManageModule(pharmacyId,branchId,"customers","edit")
      && validParty(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt == request.time;
     allow delete: if canManageModule(pharmacyId,branchId,"customers","delete");
    }
    match /inventory/{itemId}{
     allow get,list: if canManageInventory(pharmacyId,branchId,"view") || canManageModule(pharmacyId,branchId,"expiryAlerts","view") || canManageModule(pharmacyId,branchId,"reports","view") || canManageModule(pharmacyId,branchId,"stockTransfers","create") || canManageModule(pharmacyId,branchId,"stockTransfers","approve");
     allow create: if (canManageInventory(pharmacyId,branchId,"add") || (
      request.resource.data.lastTransferId is string
      && transferApproved(pharmacyId,request.resource.data.lastTransferId)
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.toBranchId == branchId
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.inventoryId == itemId
     ))
      && validInventory(request.resource.data)
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
     allow update: if (
      canManageInventory(pharmacyId,branchId,"edit")
      && validInventory(request.resource.data)
      && request.resource.data.createdBy == resource.data.createdBy
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt == request.time
     ) || (
      canManageBilling(pharmacyId,branchId,"create")
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quantity","updatedAt","updatedBy","lastSaleId"])
      && request.resource.data.quantity is number && request.resource.data.quantity >= 0
      && request.resource.data.quantity < resource.data.quantity
      && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.lastSaleId is string
      && existsAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastSaleId))
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastSaleId)).data.status == "completed"
      && existsAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastSaleId)/items/$(itemId))
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastSaleId)/items/$(itemId)).data.quantity == resource.data.quantity - request.resource.data.quantity
     ) || (
      canManageBilling(pharmacyId,branchId,"void")
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quantity","updatedAt","updatedBy","lastVoidedSaleId"])
      && request.resource.data.quantity is number && request.resource.data.quantity > resource.data.quantity
      && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.lastVoidedSaleId is string
      && existsAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastVoidedSaleId))
      && get(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastVoidedSaleId)).data.status == "completed"
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastVoidedSaleId)).data.status == "voided"
      && existsAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastVoidedSaleId)/items/$(itemId))
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(branchId)/sales/$(request.resource.data.lastVoidedSaleId)/items/$(itemId)).data.quantity == request.resource.data.quantity - resource.data.quantity
     ) || (
      transferApproved(pharmacyId,request.resource.data.lastTransferId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quantity","updatedAt","updatedBy","lastTransferId"])
      && request.resource.data.quantity is number && request.resource.data.quantity >= 0
      && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.lastTransferId is string && transferApproved(pharmacyId,request.resource.data.lastTransferId)
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.fromBranchId == branchId
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.inventoryId == itemId
      && request.resource.data.quantity == resource.data.quantity - getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.quantity
     ) || (
      canManageModule(pharmacyId,branchId,"stockTransfers","approve")
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quantity","updatedAt","updatedBy","lastTransferId"])
      && request.resource.data.quantity is number
      && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.lastTransferId is string && transferApproved(pharmacyId,request.resource.data.lastTransferId)
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.toBranchId == branchId
      && getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.inventoryId == itemId
      && request.resource.data.quantity == resource.data.quantity + getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/stockTransfers/$(request.resource.data.lastTransferId)).data.quantity
     );
     allow delete: if canManageInventory(pharmacyId,branchId,"delete");
    }
   }
   match /stockTransfers/{transferId}{
    allow get,list: if isPharmacyOwner(pharmacyId) || (isPharmacyMember(pharmacyId) && profile().role == "staff" && profile().permissions is map && profile().permissions.stockTransfers is map && profile().permissions.stockTransfers.view == true);
    allow create: if (isPharmacyOwner(pharmacyId) || (
     isPharmacyMember(pharmacyId) && profile().role == "staff"
     && profile().permissions is map && profile().permissions.stockTransfers is map
     && profile().permissions.stockTransfers.create == true
     && profile().branchId == request.resource.data.fromBranchId
    ))
     && request.resource.data.pharmacyId == pharmacyId
     && request.resource.data.fromBranchId != request.resource.data.toBranchId
     && exists(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(request.resource.data.fromBranchId))
     && exists(/databases/$(database)/documents/pharmacies/$(pharmacyId)/branches/$(request.resource.data.toBranchId))
     && request.resource.data.inventoryId is string
     && request.resource.data.quantity is int && request.resource.data.quantity > 0
     && request.resource.data.status == "pending"
     && request.resource.data.createdBy == request.auth.uid
     && request.resource.data.createdAt == request.time
     && request.resource.data.keys().hasOnly(["pharmacyId","fromBranchId","toBranchId","inventoryId","medicineName","batchNumber","quantity","status","createdBy","createdAt"]);
    allow update: if resource.data.status == "pending" && request.resource.data.status == "approved"
     && (isPharmacyOwner(pharmacyId) || (
      isPharmacyMember(pharmacyId) && profile().role == "staff"
      && profile().permissions is map && profile().permissions.stockTransfers is map
      && profile().permissions.stockTransfers.approve == true
      && (profile().branchId == resource.data.fromBranchId || profile().branchId == resource.data.toBranchId)
     ))
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","approvedBy","approvedAt"])
     && request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time;
    allow delete: if false;
   }
  }
  match /platformConfig/{configId}{allow get,list,create,update: if isActiveSuperAdmin();allow delete: if false;}
  match /subscriptionPlans/{planId}{allow get,list,create,update: if isActiveSuperAdmin();allow delete: if false;}
  match /platformAuditLogs/{logId}{
   allow create: if isActiveSuperAdmin() && request.resource.data.adminUid == request.auth.uid;
   allow get,list: if isActiveSuperAdmin();allow update,delete: if false;
  }
  match /{document=**}{allow read,write: if false;}
 }
}