rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == "superAdmin";
    }

    // Admin registry records are provisioned manually or by trusted server code.
    match /platformAdmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Super Admin controlled platform configuration.
    match /platformConfig/{configId} {
      allow get, list, create, update: if isActiveSuperAdmin();
      allow delete: if false;
    }
    match /subscriptionPlans/{planId} {
      allow get, list, create, update: if isActiveSuperAdmin();
      allow delete: if false;
    }
    match /platformAuditLogs/{logId} {
      allow create: if isActiveSuperAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow get, list: if isActiveSuperAdmin();
      allow update, delete: if false;
    }

    // Deny every other collection until its tenant-safe workflow is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}