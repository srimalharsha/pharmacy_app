rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A platform admin can read only their own registry entry.
    // Create/update this document manually in Firebase Console after creating
    // the admin's Authentication account. Client-side role escalation is denied.
    match /platformAdmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Deny all application data access until tenant-specific rules are added.
    // Do not loosen this default rule to make the demo work.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}